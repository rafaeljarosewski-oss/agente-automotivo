# =============================================================================
# Variáveis de ambiente — copie para .env.local (o `npm run setup` faz isso sozinho)
# Em produção, cadastre estas variáveis na Vercel (Settings → Environment Variables).
# =============================================================================

# Endereço público do sistema (usado nos links enviados por WhatsApp)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Local: preenchido automaticamente pelo `npm run setup` (comando `supabase status`).
# Nuvem: Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave pública ("publishable", começa com sb_publishable_). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta ("secret", começa com sb_secret_). NUNCA exponha no navegador.
SUPABASE_SECRET_KEY=

# --- Segurança ----------------------------------------------------------------
# Chave de 32 bytes em base64 para criptografar dados sensíveis no banco (ex.: CSC da NFC-e).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: se trocar esta chave, os CSCs já salvos precisam ser informados novamente.
APP_ENCRYPTION_KEY=
# Segredo exigido pelas rotinas agendadas (/api/cron/*). A Vercel envia em "Authorization: Bearer".
CRON_SECRET=

# --- Emissão fiscal -----------------------------------------------------------
# mock        → simula autorização/rejeição (desenvolvimento e testes, sem credenciais)
# acbr        → ACBr API (sucessora da Nuvem Fiscal — https://dev.acbr.api.br)
# nuvemfiscal → API legada da Nuvem Fiscal (desativada em 31/07/2026; mantida só por compatibilidade)
FISCAL_PROVIDER=mock
# Credenciais OAuth2 (client_credentials) da conta da Órion na API fiscal.
# Use credenciais de SANDBOX/homologação enquanto estiver testando.
FISCAL_CLIENT_ID=
FISCAL_CLIENT_SECRET=
# Tipo de credencial: "sandbox" (servidor de testes da API) ou "producao".
# Atenção: o AMBIENTE da SEFAZ/prefeitura (homologação × produção) é escolhido por loja,
# em Configurações › Fiscal. Use credencial "producao" para emitir em qualquer ambiente real.
FISCAL_CREDENCIAL=sandbox
# Escopos solicitados no token
FISCAL_SCOPES=empresa cep cnpj nfse nfe nfce
# (Opcional) Sobrescrever URLs da API — por padrão são escolhidas pelo provedor e pelo tipo de credencial
# FISCAL_API_URL=https://hom.acbr.api.br
# FISCAL_TOKEN_URL=https://auth.acbr.api.br/realms/ACBrAPI/protocol/openid-connect/token
# Segredo compartilhado para validar a assinatura HMAC-SHA256 dos webhooks recebidos em /api/fiscal/webhook
FISCAL_WEBHOOK_SECRET=

# Responsável técnico pelo software (grupo infRespTec da NF-e/NFC-e). Dados da Órion.
# Algumas SEFAZ exigem; deixe o CNPJ vazio para não enviar o grupo.
RESP_TECNICO_CNPJ=
RESP_TECNICO_CONTATO=Órion Automação Inteligente
RESP_TECNICO_EMAIL=
RESP_TECNICO_FONE=

# --- Somente para FISCAL_PROVIDER=mock (desenvolvimento) --------------------------
# Tempo (ms) que a nota simulada fica "em processamento" antes de ser autorizada
# MOCK_FISCAL_ATRASO_MS=1500
# Se definido, o simulador também chama este endereço como se fosse o webhook do provedor
# MOCK_FISCAL_WEBHOOK_URL=http://localhost:3000/api/fiscal/webhook

# --- Somente para scripts ---------------------------------------------------------
# Permite rodar o seed de demonstração num banco remoto (NUNCA no banco de produção)
# SEED_PERMITIR_REMOTO=1
